              "integer",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "hotelItemId": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "select",
              "container",
              "entity",
              "number",
              "check"
            ]
          },
