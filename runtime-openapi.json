          "hotelItemId": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "select",
              "container",
              "entity",
              "number",
              "check"
            ]
          },
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "numberValue": {
            "type": [
              "integer",
              "null"
