        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "contentType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2097152
          }
        },
        "required": [
          "filename",
          "contentType",
          "sizeBytes"
        ]
      },
      "ClientWithHotelsResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ClientResponse"
