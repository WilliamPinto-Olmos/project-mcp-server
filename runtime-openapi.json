          "type"
        ]
      },
      "HotelUpsertOpenApi": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "mainContactName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "mainContactEmail": {
            "type": "string",
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "hotelTypeId": {
            "type": "integer",
            "exclusiveMinimum": 0
