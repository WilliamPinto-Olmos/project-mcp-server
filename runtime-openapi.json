        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "mainContactName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "mainContactEmail": {
            "type": "string",
            "maxLength": 100
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "hotelTypeId": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "countryId": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "stateId": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "cityId": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "zoneId": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "starCategoryRating": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "diamondRating": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "inventory": {
            "$ref": "#/components/schemas/HotelInventory"
          },
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HotelPhotoInput"
            },
            "maxItems": 20,
            "default": []
          },
          "auditModules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditModuleAssignmentInput"
            }
          }
        },
        "required": [
          "name",
          "mainContactName",
          "mainContactEmail",
          "address",
          "hotelTypeId",
          "countryId",
          "stateId",
          "cityId",
          "inventory"
        ]
      }
    },
    "parameters": {}
