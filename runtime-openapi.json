            "required": [
              "hotels"
            ]
          }
        ]
      },
      "ClientTypeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
