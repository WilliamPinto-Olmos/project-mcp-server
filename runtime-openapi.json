{
  "openapi": "3.1.0",
  "info": {
    "title": "CIS Backend API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Estado del servicio y dependencias"
