          "diamondRating": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "inventory": {
            "$ref": "#/components/schemas/HotelInventory"
          },
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HotelPhotoInput"
