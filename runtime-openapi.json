          },
          "readExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "storagePath",
          "uploadUrl",
          "uploadExpiresAt",
          "readUrl",
          "readExpiresAt"
        ]
      },
